<%
  var tocHtml = "";
  try {
    tocHtml = toc(page.content, { list_number: false, min_depth: 2, max_depth: 3 });
  } catch (e) {
    tocHtml = "";
  }
  var hasToc = tocHtml && tocHtml.indexOf("toc-link") > -1;
%>
<main class="page-shell">
  <% if (hasToc) { %>
  <!-- 宽屏：右侧浮动目录 -->
  <aside class="post-toc" id="postToc" aria-label="文章目录">
    <div class="post-toc-title">目录</div>
    <nav class="post-toc-body"><%- tocHtml %></nav>
  </aside>
  <% } %>

  <article class="panel post-article">
    <nav class="post-back" aria-label="返回">
      <a class="btn-back" href="<%- url_for('/archives/') %>" title="返回文章列表">
        <span class="arrow">←</span> 返回列表
      </a>
      <a class="btn-back home" href="<%- url_for('/') %>" title="回到首页">首页</a>
    </nav>
    <p class="eyebrow">Blog Post</p>
    <h1 class="post-title gradient-text"><%= page.title %></h1>
    <div class="post-meta">
      <span class="post-meta-date"><%= date(page.date, 'YYYY-MM-DD') %></span>
      <% if (page.categories && page.categories.length) { %>
        <span class="post-meta-sep">|</span>
        <% page.categories.forEach(function(cat){ %>
          <a href="<%- url_for(cat.path) %>" class="post-meta-cat"><%= cat.name %></a>
        <% }) %>
      <% } %>
    </div>

    <% if (hasToc) { %>
    <!-- 窄屏：折叠目录 -->
    <details class="post-toc-inline">
      <summary>目录</summary>
      <nav><%- tocHtml %></nav>
    </details>
    <% } %>

    <div class="post-content">
      <%- page.content %>
    </div>
    <% if (page.tags && page.tags.length) { %>
    <!-- 小标签只做展示，不带链接 -->
    <div class="post-tags">
      <% page.tags.forEach(function(tag){ %>
        <span class="tag">#<%= tag.name %></span>
      <% }) %>
    </div>
    <% } %>
  </article>

  <nav class="post-nav">
    <% if (page.prev) { %>
    <a class="mini-card post-nav-item" href="<%- url_for(page.prev.path) %>">
      <span class="post-nav-label">上一篇</span>
      <span class="post-nav-title"><%= page.prev.title %></span>
    </a>
    <% } %>
    <% if (page.next) { %>
    <a class="mini-card post-nav-item" href="<%- url_for(page.next.path) %>">
      <span class="post-nav-label">下一篇</span>
      <span class="post-nav-title"><%= page.next.title %></span>
    </a>
    <% } %>
  </nav>
</main>
