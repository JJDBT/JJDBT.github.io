<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' - ' + config.title : config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <meta name="keywords" content="<%= config.keywords %>">
  <meta name="author" content="<%= config.author %>">
  <link rel="icon" href="/tupian/avatar-96.png">
  <link rel="stylesheet" href="/css/style.css?v=20261124">
  <link rel="stylesheet" href="/css/custom.css?v=20261124">
  <script src="/js/main.js?v=20261124" defer></script>
</head>
<body>
  <div id="loading-screen">
    <div class="loading-bg-layer"></div>
    <div class="loading-content">
      <div class="loading-miku">
        <div class="loading-ring"></div>
        <img src="/img/miku-chibi.jpg" alt="初音未来" class="loading-miku-img">
      </div>
      <div class="loading-bar-wrap">
        <div class="loading-bar" id="loading-bar"></div>
      </div>
      <div class="loading-info">
        <span class="loading-text" id="loading-text">加载中</span>
        <span class="loading-percent" id="loading-percent">0%</span>
      </div>
    </div>
  </div>
  <header class="site-header">
    <nav class="navbar" aria-label="主导航">
      <a class="brand" href="/">
        <img src="/tupian/avatar-96.png" alt="小初音头像">
        <span>我的二次元小站</span>
      </a>
      <div class="nav-links">
        <%
          /* 用 page.path 精确判断当前页，避免 is_category()/is_tag()
             在首页误判导致多个按钮同时高亮 */
          var curPath = String(page.path || '').toLowerCase();
          function navOn(prefix) {
            if (!prefix) {
              return curPath === '' || curPath === 'index.html';
            }
            return curPath.indexOf(prefix) === 0;
          }
        %>
        <a href="/" class="<%= navOn('') ? 'active' : '' %>">首页</a>
        <a href="/about/" class="<%= navOn('about/') ? 'active' : '' %>">关于我</a>
        <a href="/works/" class="<%= navOn('works/') ? 'active' : '' %>">推荐作品</a>
        <a href="/friends/" class="<%= navOn('friends/') ? 'active' : '' %>">友人帐</a>
        <a href="/archives/" class="<%= navOn('archives/') ? 'active' : '' %>">文章</a>
      </div>
    </nav>
  </header>

  <%- body %>

  <!-- 看板娘：气泡 + 加载失败时的立绘兜底 -->
  <div class="moe-bubble" id="moeBubble" aria-live="polite"></div>
  <img class="moe-fallback" id="moeFallback" data-src="/tupian/初音场景.webp" alt="看板娘">

  <footer class="footer">愿每次打开这个小站，都能遇到一点可爱的灵感。</footer>
</body>
</html>
