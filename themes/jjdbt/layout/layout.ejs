<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' - ' + config.title : config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <meta name="keywords" content="<%= config.keywords %>">
  <meta name="author" content="<%= config.author %>">
  <link rel="icon" href="/tupian/1_128177484.png">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://l2dwidget.js.org/lib/L2Dwidget.min.js"></script>
  <script src="/js/main.js" defer></script>
</head>
<body>
  <div id="loading-screen">
    <div class="loading-bg-layer"></div>
    <div class="loading-content">
      <div class="loading-miku">
        <div class="loading-ring"></div>
        <img src="/img/miku-chibi.jpg" alt="初音未来" class="loading-miku-img">
      </div>
      <div class="loading-bar-wrap">
        <div class="loading-bar" id="loading-bar"></div>
      </div>
      <div class="loading-info">
        <span class="loading-text" id="loading-text">加载中</span>
        <span class="loading-percent" id="loading-percent">0%</span>
      </div>
    </div>
  </div>
  <header class="site-header">
    <nav class="navbar" aria-label="主导航">
      <a class="brand" href="/">
        <img src="/tupian/1_128177484.png" alt="小初音头像">
        <span>我的二次元小站</span>
      </a>
      <div class="nav-links">
        <a href="/" class="<% if (is_home()) { %>active<% } %>">首页</a>
        <a href="/about/" class="<% if (is_page('about')) { %>active<% } %>">关于我</a>
        <a href="/works/" class="<% if (is_page('works')) { %>active<% } %>">推荐作品</a>
        <a href="/archives/" class="<% if (is_archive()) { %>active<% } %>">文章</a>
      </div>
    </nav>
  </header>

  <aside class="side-decoration left" aria-label="左侧角色装饰">
    <a href="https://baike.baidu.com/item/%E4%BC%8A%E8%95%BE%E5%A8%9C/22505183" target="_blank" rel="noopener noreferrer"><img src="/tupian/伊蕾娜.jpg" style="top: 4%;" alt="伊蕾娜"></a>
    <a href="https://baike.baidu.com/item/%E6%B4%9B%E7%90%AA%E5%B8%8C%C2%B7%E7%B1%B3%E6%A0%BC%E8%B7%AF%E8%BF%AA%E4%BA%9A%C2%B7%E6%A0%BC%E9%9B%B7%E6%8B%89%E7%89%B9/22138349" target="_blank" rel="noopener noreferrer"><img src="/tupian/洛琪希右.jpg" style="top: 31%; animation-delay: 1.2s;" alt="洛琪希"></a>
    <a href="https://baike.baidu.com/item/%E6%83%A3%E6%B5%81%C2%B7%E6%98%8E%E6%97%A5%E9%A6%99%C2%B7%E5%85%B0%E6%A0%BC%E9%9B%B7/6960961?fromtitle=%E6%98%8E%E6%97%A5%E9%A6%99&fromid=35092" target="_blank" rel="noopener noreferrer"><img src="/tupian/明日香右.jpg" style="top: 58%; animation-delay: 2.1s;" alt="明日香"></a>
    <a href="https://baike.baidu.com/item/%E9%80%A2%E5%9D%82%E5%A4%A7%E6%B2%B3/4013512" target="_blank" rel="noopener noreferrer"><img src="/tupian/萌虎右.jpg" style="top: 79%; animation-delay: 3s;" alt="逢坂大河"></a>
  </aside>

  <aside class="side-decoration right" aria-label="右侧角色装饰">
    <a href="https://baike.baidu.com/item/%E4%BA%9A%E6%89%98%E8%8E%89/50041942?fromModule=disambiguation" target="_blank" rel="noopener noreferrer"><img src="/tupian/亚托莉左.jpg" style="top: 8%;" alt="亚托莉"></a>
    <a href="https://baike.baidu.com/item/%E5%8F%8B%E5%88%A9%E5%A5%88%E7%BB%AA?fromModule=lemma_search-box" target="_blank" rel="noopener noreferrer"><img src="/tupian/友利绪奈左.jpg" style="top: 34%; animation-delay: 1.3s;" alt="友利奈绪"></a>
    <a href="https://baike.baidu.com/item/%E8%83%A1%E6%A1%83/56530441?fromModule=lemma_search-box" target="_blank" rel="noopener noreferrer"><img src="/tupian/胡桃左.jpg" style="top: 59%; animation-delay: 2.2s;" alt="胡桃"></a>
    <a href="https://baike.baidu.com/item/%E8%8A%99%E5%AE%81%E5%A8%9C%C2%B7%E5%BE%B7%C2%B7%E6%9E%AB%E4%B8%B9/63688326?fromtitle=%E8%8A%99%E5%AE%81%E5%A8%9C&fromid=63096882" target="_blank" rel="noopener noreferrer"><img src="/tupian/芙宁娜左.jpg" style="top: 80%; animation-delay: 3.1s;" alt="芙宁娜"></a>
  </aside>

  <%- body %>

  <div class="live2d-anchor" aria-hidden="true"></div>
  <footer class="footer">愿每次打开这个小站，都能遇到一点可爱的灵感。</footer>
</body>
</html>
