<main class="page-shell">
  <section class="panel">
    <p class="eyebrow">Archive</p>
    <h1 class="page-title"><span class="gradient-text">所有文章</span></h1>
    <p class="page-lead">共 <%= site.posts.length %> 篇文章</p>
  </section>

  <section class="section">
    <% if (site.categories.length) { %>
    <div class="filter-bar">
      <span class="filter-label">按分类查看</span>
      <div class="filter-chips">
        <a class="filter-chip is-active" href="<%- url_for('/archives/') %>">
          全部<em><%= site.posts.length %></em>
        </a>
        <% site.categories.sort('-length').each(function(cat){ %>
        <a class="filter-chip" href="<%- url_for(cat.path) %>">
          <%= cat.name %><em><%= cat.length %></em>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="archive-list" id="archiveList">
      <% var lastYear = -1; %>
      <% page.posts.forEach(function(post){ %>
        <% var year = date(post.date, 'YYYY'); %>
        <% if (year !== lastYear) { %>
          <% lastYear = year; %>
          <h2 class="archive-year"><%= year %></h2>
        <% } %>
        <%
          var tagNames = [];
          if (post.tags) { post.tags.forEach(function(t){ tagNames.push(t.name); }); }
          var catNames = [];
          if (post.categories) { post.categories.forEach(function(c){ catNames.push(c.name); }); }
        %>
        <a class="archive-item" href="<%- url_for(post.path) %>"
           data-tags="<%= tagNames.join('|') %>"
           data-cats="<%= catNames.join('|') %>">
          <span class="archive-date"><%= date(post.date, 'MM-DD') %></span>
          <span class="archive-title"><%= post.title %></span>
          <span class="archive-meta">
            <% if (tagNames.length) { %><span class="archive-tags"><% tagNames.forEach(function(t){ %><span class="archive-tag">#<%= t %></span><% }); %></span><% } %>
            <% if (catNames.length) { %><span class="archive-cat"><%= catNames[0] %></span><% } %>
          </span>
        </a>
      <% }) %>
    </div>
  </section>

  <nav class="pagination">
    <% if (page.prev) { %><a class="button secondary" href="<%- url_for(page.prev_link) %>">← 上一页</a><% } %>
    <% if (page.next) { %><a class="button secondary" href="<%- url_for(page.next_link) %>">下一页 →</a><% } %>
  </nav>
</main>
